# Database
DATABASE_URL="file:./zllama.db"
# DATABASE_URL="postgresql://user:pass@host:5432/zllama"

# App
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Reverse-proxy sub-path deployment (optional)
# Set when the app is served behind a reverse proxy under a path prefix
# (e.g. https://example.com/zllama). Must be set at BUILD TIME — Next.js
# bakes basePath into the client bundle, so changing it later requires rebuild.
# When set, also include the prefix in NEXTAUTH_URL (e.g. https://example.com/zllama).
# Leave empty for root-path deployment (default).
#
# Windows + Git Bash gotcha: MSYS rewrites a leading-slash value into a Windows
# path (e.g. "/zllama" -> "C:/Users/.../zllama"), which then crashes
# the build with a path-to-regexp error. Use MSYS_NO_PATHCONV=1, a double slash
# (//zllama), or set the variable in this .env file instead.
# NEXT_PUBLIC_BASE_PATH=/zllama

# Auth (admin user is created during first-time setup wizard)
# AUTH_DISABLED=true  # Set to true only for local development to bypass login

# Rate limiting
# Set to true only when the app sits behind a reverse proxy that overwrites
# X-Forwarded-For (rather than appending a client-supplied value). Leaving it
# unset means every request shares one rate-limit bucket per x-real-ip or the
# "unknown" fallback.
# TRUST_PROXY_HEADERS=true

# Ollama (default server, also configurable from the UI)
DEFAULT_OLLAMA_URL="http://localhost:11434"

# Logging
LOG_RETENTION_DAYS=90
LOG_STORE_PROMPTS=true

# Catalog
CATALOG_REFRESH_ENABLED=true
CATALOG_RATE_LIMIT_MS=2000

# HTTP Proxy (for servers behind a corporate proxy that need to reach ollama.com)
# HTTPS_PROXY=http://proxy.example.com:8080

# Fleet agent enrollment
# Shared token the zllama_agent processes present (as `Authorization: Bearer`)
# when checking in at /api/agent/checkin. A valid token only lets a host
# report its facts — new hosts still land in approvalState "pending" and
# stay inert until an operator approves them from the Hosts UI.
#
# Approving a host and assigning it a role is still not enough for it to
# change anything: applying convergence changes is a separate, deliberate,
# per-host, LOCAL opt-in (converge: true in that host's own agent.yaml, plus
# running `zllama_agent.main --allow-apply` on the host itself) — never
# something this token or this server can flip on remotely. See
# docs/fleet-agent.md for the full operator path, including how a freshly
# enrolled host is dry-run only by design, and how to reverse the opt-in
# (--disallow-apply).
# AGENT_ENROLL_TOKEN=change-me-shared-agent-token
